CONSOLE_ADMIN_USERNAME=admin
# Set a unique password before first startup. This file contains no defaults.
CONSOLE_ADMIN_PASSWORD=
CONSOLE_DATA_DIR=./data
CONSOLE_ALLOWED_ORIGINS=http://127.0.0.1:18765
# Explicit opt-out only for local HTTP development. Use HTTPS and 0 otherwise.
CONSOLE_DEV_INSECURE_COOKIE=1
CONSOLE_SECRETS_FILE=./secrets.json
CONSOLE_CACHE_MAX_BYTES=536870912
CONSOLE_CACHE_TTL_SECONDS=604800
